{
  "name": "@shucode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for shucode",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/shucode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@shucode/adapters": "workspace:*",
    "@shucode/bootstrap": "workspace:*",
    "@shucode/contracts": "workspace:*",
    "@shucode/core": "workspace:*",
    "@shucode/dynamic-workflow-runtime": "workspace:*",
    "@shucode/i18n": "workspace:*",
    "@shucode/provider-node": "workspace:*",
    "@shucode/shared": "workspace:*",
    "@shucode/shared-types": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
